{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "target": "es2016",
    "outDir": "dist",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "noImplicitAny": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./**/*"
  ]
}